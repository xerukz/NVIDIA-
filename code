<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Cloud Gaming</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: #101010;
      color: #fff;
      font-family: system-ui, sans-serif;
    }

    .card {
      width: min(92%, 520px);
      padding: 32px;
      border-radius: 20px;
      background: #181818;
      text-align: center;
      box-shadow: 0 20px 60px #0008;
    }

    h1 {
      margin-top: 0;
    }

    button {
      width: 100%;
      padding: 14px;
      border: 0;
      border-radius: 12px;
      background: #76b900;
      color: white;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
    }

    button:hover {
      filter: brightness(1.1);
    }

    #settings {
      margin-top: 20px;
      text-align: left;
      display: none;
    }

    .setting {
      padding: 12px 0;
      border-bottom: 1px solid #333;
    }
  </style>
</head>

<body>
  <main class="card">
    <h1>Cloud Gaming</h1>
    <p>Launch NVIDIA GeForce NOW</p>

    <button id="launch">
      Open GeForce NOW
    </button>

    <section id="settings">
      <h2>Settings</h2>

      <div class="setting">
        Browser storage:
        <strong id="storage">Checking...</strong>
      </div>

      <div class="setting">
        Window:
        <strong>Normal</strong>
      </div>
    </section>
  </main>

  <script>
    const settings = document.querySelector("#settings");
    const storage = document.querySelector("#storage");

    document.querySelector("#launch").addEventListener("click", () => {
      window.open(
        "https://play.geforcenow.com/",
        "_blank",
        "noopener,noreferrer"
      );
    });

    try {
      localStorage.setItem("axiom_test", "1");
      localStorage.removeItem("axiom_test");
      storage.textContent = "Available";
    } catch {
      storage.textContent = "Unavailable";
    }

    /*
      Legitimate settings panel.
      No iframe cloaking, about:blank masking,
      filter evasion, or monitoring bypass behavior.
    */

    let clicks = 0;

    document.addEventListener("keydown", event => {
      if (event.key.toLowerCase() === "s") {
        clicks++;

        if (clicks >= 3) {
          settings.style.display =
            settings.style.display === "none"
              ? "block"
              : "none";

          clicks = 0;
        }
      }
    });
  </script>
</body>
</html>